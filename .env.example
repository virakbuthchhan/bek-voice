# Local Compose port. Change this if 8765 is already in use.
PORT=8765

# VPS HTTPS setup: replace these with your real hostname and certificate email.
DOMAIN=voice.example.com
ACME_EMAIL=you@example.com

# GPU VPS only (compose.gpu.yaml). Generate a random token with openssl rand -hex 32.
# Never use your SSH password/private key as the API token.
BEK_API_TOKEN=
# Comma-separated exact origins, no trailing slash or wildcard.
# Include the VPS app and any separately hosted/local app that may connect.
BEK_ALLOWED_ORIGINS=https://voice.example.com,http://127.0.0.1:8765,http://localhost:8765
